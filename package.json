{
  "name": "fuzzykit",
  "version": "0.1.0",
  "description": "Zero-dependency string similarity and fuzzy search for TypeScript: Levenshtein, Jaro-Winkler, Sorensen-Dice, and a ranked search.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fuzzy-search",
    "string-similarity",
    "levenshtein",
    "jaro-winkler",
    "dice-coefficient",
    "typescript",
    "zero-dependency"
  ],
  "author": "Abdul Raheem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoogeyCodes/fuzzykit.git"
  },
  "homepage": "https://github.com/BoogeyCodes/fuzzykit#readme",
  "bugs": {
    "url": "https://github.com/BoogeyCodes/fuzzykit/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
